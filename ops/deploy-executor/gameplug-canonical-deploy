#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly REPOSITORY="https://github.com/robinswood-io/game-plug.git"
readonly REPO_DIR="/srv/workspace/.deploy/gameplug/repo"
readonly STATE_DIR="/srv/workspace/.deploy/gameplug"
readonly ENV_FILE="/srv/workspace/.secrets/gameplug-backend.env"
readonly ENABLE_FILE="/etc/gameplug-deploy/enabled"
readonly ROLLBACK_DIR="/srv/workspace/.recovery/gameplug-cutover-edc014e-20260824-2313"
readonly ROLLBACK_SCRIPT="${ROLLBACK_DIR}/rollback-source-runtime.sh"
readonly BACKEND_REPO="ghcr.io/robinswood-io/game-plug-backend"
readonly FRONTEND_REPO="ghcr.io/robinswood-io/game-plug-frontend"
readonly CANARY_NETWORK="gameplug-canonical-canary"
readonly CANARY_BACKEND="gameplug-canonical-canary-backend"
readonly CANARY_FRONTEND="gameplug-canonical-canary-frontend"
readonly LOCK_FILE="${STATE_DIR}/deploy.lock"
readonly PUBLIC_HOME_URL="https://game-plug.rbw.ovh/"
readonly PUBLIC_HEALTH_URL="https://game-plug.rbw.ovh/api/health"
ROLLBACK_ATTEMPTED=false

log() { printf '[gameplug-deploy] %s\n' "$*"; }
die() { log "DENIED: $*" >&2; exit 64; }

validate_manifest() {
  local sha=$1 backend_digest=$2 frontend_digest=$3
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit SHA"
  [[ "$backend_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "invalid backend digest"
  [[ "$frontend_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "invalid frontend digest"
}

parse_entry() {
  [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]] || die "missing forced command"
  local -a argv
  read -r -a argv <<< "$SSH_ORIGINAL_COMMAND"
  [[ ${#argv[@]} -eq 4 ]] || die "command shape is not allowlisted"
  case "${argv[0]}" in
    preflight|canary|deploy) ;;
    *) die "command is not allowlisted" ;;
  esac
  ACTION=${argv[0]}
  DEPLOY_SHA=${argv[1]}
  BACKEND_DIGEST=${argv[2]}
  FRONTEND_DIGEST=${argv[3]}
}

ensure_repository() {
  mkdir -p "$STATE_DIR"
  if [[ ! -d "$REPO_DIR/.git" ]]; then
    git clone --filter=blob:none --no-checkout "$REPOSITORY" "$REPO_DIR" >/dev/null
  fi
  git -C "$REPO_DIR" fetch --quiet --prune origin main
  local remote_main
  remote_main=$(git -C "$REPO_DIR" rev-parse origin/main)
  [[ "$remote_main" = "$DEPLOY_SHA" ]] || die "requested SHA is not current origin/main"
  git -C "$REPO_DIR" checkout --quiet --detach "$DEPLOY_SHA"
}

verify_env() {
  [[ -f "$ENV_FILE" ]] || die "backend environment is missing"
  [[ $(stat -c %a "$ENV_FILE") = 600 ]] || die "backend environment must be mode 0600"
  local key
  for key in DATABASE_URL REDIS_URL JWT_SECRET OPENAI_API_KEY GAMEPLUG_DEMO_AUTH_ENABLED; do
    grep -aq "^${key}=" "$ENV_FILE" || die "backend environment key missing: $key"
  done
  grep -aq '^GAMEPLUG_DEMO_AUTH_ENABLED=false$' "$ENV_FILE" || die "public demo auth must remain disabled"
}

verify_enable_gate_metadata() {
  local gate=$1 mode=$2 uid=$3 gid=$4
  if [[ ! -f "$gate" || -L "$gate" ]]; then
    log "local cutover gate must be a regular non-symlink file" >&2
    return 1
  fi
  if [[ "$uid" != 0 || "$gid" != 0 ]]; then
    log "local cutover gate must be owned by root:root" >&2
    return 1
  fi
  if [[ "$mode" != 644 ]]; then
    log "local cutover gate must be mode 0644" >&2
    return 1
  fi
  if ! cmp -s -- "$gate" <(printf 'enabled=true\n'); then
    log "local cutover gate content is not exact" >&2
    return 1
  fi
}

verify_enable_gate() {
  local gate=$1 mode uid gid
  [[ -e "$gate" ]] || { log "local cutover gate is disabled" >&2; return 1; }
  mode=$(stat -c %a -- "$gate") || return 1
  uid=$(stat -c %u -- "$gate") || return 1
  gid=$(stat -c %g -- "$gate") || return 1
  verify_enable_gate_metadata "$gate" "$mode" "$uid" "$gid"
}

verify_rollback() {
  [[ -x "$ROLLBACK_SCRIPT" ]] || die "source-runtime rollback script unavailable"
  (cd "$ROLLBACK_DIR" && sha256sum --quiet -c SHA256SUMS) || die "rollback bundle checksum mismatch"
}

verify_image() {
  local repo=$1 digest=$2 expected_sha=$3 strict_revision=$4
  local tag_ref="${repo}:${expected_sha}"
  docker pull --quiet "$tag_ref" >/dev/null
  docker image inspect "$tag_ref" --format '{{json .RepoDigests}}' | grep -Fq "@${digest}" || die "tag-to-digest binding mismatch"
  local digest_ref="${repo}@${digest}"
  docker pull --quiet "$digest_ref" >/dev/null
  [[ $(docker image inspect "$digest_ref" --format '{{.Config.User}}') = bun ]] || die "image runtime user is not bun"
  local revision
  revision=$(docker image inspect "$digest_ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')
  if [[ "$revision" != "$expected_sha" ]]; then
    if [[ "$strict_revision" = true ]]; then
      die "OCI revision does not bind image to requested main SHA"
    fi
    log "PROVENANCE_BLOCKER: OCI revision differs from requested SHA; canary allowed, deploy forbidden"
  fi
}

preflight() {
  local strict_revision=${1:-false}
  ensure_repository
  verify_env
  verify_rollback
  verify_image "$BACKEND_REPO" "$BACKEND_DIGEST" "$DEPLOY_SHA" "$strict_revision"
  verify_image "$FRONTEND_REPO" "$FRONTEND_DIGEST" "$DEPLOY_SHA" "$strict_revision"
  docker network inspect dev_network >/dev/null
  docker network inspect traefik_public >/dev/null
  log "preflight complete for immutable image digests"
}

cleanup_canary() {
  docker rm -f "$CANARY_FRONTEND" "$CANARY_BACKEND" >/dev/null 2>&1 || true
  docker network rm "$CANARY_NETWORK" >/dev/null 2>&1 || true
}

verify_canary_ports_closed() {
  local sockets
  if ! sockets=$(ss -ltn); then
    log "unable to inspect canary listeners" >&2
    return 1
  fi
  if grep -Eq '127\.0\.0\.1:5523[01] ' <<< "$sockets"; then
    log "canary listener remains open after cleanup" >&2
    return 1
  fi
}

wait_http() {
  local label=$1 url=$2 attempts=${3:-30} delay=${4:-2}
  local attempt
  [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || { log "invalid HTTP wait attempt bound" >&2; return 2; }
  [[ "$delay" =~ ^[0-9]+$ ]] || { log "invalid HTTP wait delay" >&2; return 2; }
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if curl --fail --silent --show-error --connect-timeout 5 --max-time 10 "$url" >/dev/null 2>&1; then
      log "${label} ready after attempt ${attempt}/${attempts}"
      return 0
    fi
    if (( attempt < attempts )); then
      log "${label} not ready at attempt ${attempt}/${attempts}; retrying"
      sleep "$delay"
    fi
  done
  log "${label} timed out after ${attempts} attempts" >&2
  return 1
}

wait_container_healthy() {
  local name=$1 attempts=${2:-30} delay=${3:-2}
  local attempt status
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    status=$(docker inspect "$name" --format '{{.State.Health.Status}}' 2>/dev/null || true)
    if [[ "$status" == healthy ]]; then
      log "container ${name} healthy after attempt ${attempt}/${attempts}"
      return 0
    fi
    if (( attempt < attempts )); then
      sleep "$delay"
    fi
  done
  log "container ${name} health timed out after ${attempts} attempts" >&2
  return 1
}

canary() {
  preflight false
  cleanup_canary
  trap cleanup_canary EXIT
  docker network create "$CANARY_NETWORK" >/dev/null
  docker run -d --name "$CANARY_BACKEND" --restart no \
    --network dev_network --env-file "$ENV_FILE" \
    -e NODE_ENV=production -e PORT=4000 \
    -p 127.0.0.1:55230:4000 \
    "${BACKEND_REPO}@${BACKEND_DIGEST}" >/dev/null
  docker network connect --alias game-plug-backend "$CANARY_NETWORK" "$CANARY_BACKEND"
  docker run -d --name "$CANARY_FRONTEND" --restart no \
    --network "$CANARY_NETWORK" \
    -e NODE_ENV=production -e HOSTNAME=0.0.0.0 -e PORT=5000 \
    -p 127.0.0.1:55231:5000 \
    "${FRONTEND_REPO}@${FRONTEND_DIGEST}" >/dev/null
  wait_http "backend canary health" http://127.0.0.1:55230/api/health || die "backend canary health failed"
  wait_http "frontend canary health" http://127.0.0.1:55231/ || die "frontend canary health failed"
  wait_http "frontend-to-backend canary proxy" http://127.0.0.1:55231/api/health || die "frontend-to-backend canary proxy failed"
  [[ $(docker inspect "$CANARY_BACKEND" --format '{{.HostConfig.RestartPolicy.Name}}') = no ]]
  [[ $(docker inspect "$CANARY_FRONTEND" --format '{{.HostConfig.RestartPolicy.Name}}') = no ]]
  [[ $(docker inspect "$CANARY_BACKEND" --format '{{.Config.User}}') = bun ]]
  [[ $(docker inspect "$CANARY_FRONTEND" --format '{{.Config.User}}') = bun ]]
  log "exact-digest isolated canary passed"
  cleanup_canary
  trap - EXIT
  verify_canary_ports_closed || die "canary listener cleanup could not be verified"
}

rollback_once() {
  local rollback_script=$1 home_url=$2 health_url=$3
  if [[ "$ROLLBACK_ATTEMPTED" == true ]]; then
    log "source-runtime rollback already attempted; refusing duplicate execution" >&2
    return 75
  fi
  ROLLBACK_ATTEMPTED=true
  log "canonical deployment failed; restoring verified source-runtime once"
  if ! "$rollback_script"; then
    log "source-runtime rollback command failed" >&2
    return 1
  fi
  wait_http "public homepage after rollback" "$home_url" 45 2 || return 1
  wait_http "public health after rollback" "$health_url" 45 2 || return 1
  log "verified source-runtime restored"
}

perform_cutover() {
  docker rm -f game-plug game-plug-backend >/dev/null 2>&1 || true
  docker compose -f "$REPO_DIR/compose.production.yml" up -d || return $?
  wait_container_healthy game-plug 30 2 || return 1
  wait_container_healthy game-plug-backend 30 2 || return 1
  wait_http "public homepage after deploy" "$PUBLIC_HOME_URL" 45 2 || return 1
  wait_http "public health after deploy" "$PUBLIC_HEALTH_URL" 45 2 || return 1
}

deploy() {
  verify_enable_gate "$ENABLE_FILE" || die "local cutover gate is disabled or invalid"
  preflight true
  canary
  export GAMEPLUG_BACKEND_IMAGE="${BACKEND_REPO}@${BACKEND_DIGEST}"
  export GAMEPLUG_FRONTEND_IMAGE="${FRONTEND_REPO}@${FRONTEND_DIGEST}"
  export GAMEPLUG_BACKEND_ENV_FILE="$ENV_FILE"
  docker compose -f "$REPO_DIR/compose.production.yml" config --quiet

  local deploy_rc=0 rollback_rc=0
  perform_cutover || deploy_rc=$?
  if (( deploy_rc != 0 )); then
    rollback_once "$ROLLBACK_SCRIPT" "$PUBLIC_HOME_URL" "$PUBLIC_HEALTH_URL" || rollback_rc=$?
    if (( rollback_rc == 0 )); then
      die "canonical deployment failed; verified source-runtime restored"
    fi
    die "canonical deployment failed and source-runtime rollback could not be verified"
  fi
  log "canonical deployment verified"
}

main() {
  [[ ${1:-} = ssh-entry ]] || die "direct execution is not permitted"
  parse_entry
  validate_manifest "$DEPLOY_SHA" "$BACKEND_DIGEST" "$FRONTEND_DIGEST"
  mkdir -p "$STATE_DIR"
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "another deployment operation is active"
  case "$ACTION" in
    preflight) preflight false ;;
    canary) canary ;;
    deploy) deploy ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
