# Verdaccio registry for @robinswood scope
@robinswood:registry=https://verdaccio.robinswood.io

# Fallback to npm for other packages
registry=https://registry.npmjs.org

# Authentication token (set via: npm login --registry https://verdaccio.robinswood.io)
# The token will be added here after login:
# //verdaccio.robinswood.io/:_authToken=<token>
