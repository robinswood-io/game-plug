# API Configuration
# Base URL for the Game Plug API backend
NEXT_PUBLIC_API_URL=http://localhost:5002

# Authentication Configuration
# Token expiration warning time (in milliseconds, default: 60000 = 1 minute)
NEXT_PUBLIC_TOKEN_WARNING_TIME=60000

# API Timeout (in milliseconds, default: 10000 = 10 seconds)
NEXT_PUBLIC_API_TIMEOUT=10000

# Enable debug logging for API calls
NEXT_PUBLIC_API_DEBUG=false
