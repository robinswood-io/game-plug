# =============================================================================
# Game-Plug Environment Configuration
# =============================================================================
# Copy this file to .env and fill in with your values
# Values with defaults are optional
# IMPORTANT: Never commit actual secrets to version control
# =============================================================================

# =============================================================================
# Application Environment
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# Database name
POSTGRES_DB=game_plug

# Database user
POSTGRES_USER=game_plug

# Database password (CHANGE THIS IN PRODUCTION)
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Database port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Auto-generated from above variables in Docker, or override here if needed
DATABASE_URL=postgresql://game_plug:your-secure-postgres-password-here@postgres:5432/game_plug

# =============================================================================
# Redis Cache & Session Store Configuration
# =============================================================================
# Redis authentication password (CHANGE THIS IN PRODUCTION)
REDIS_PASSWORD=your-secure-redis-password-here

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis connection URL
# Format: redis://:password@host:port
REDIS_URL=redis://:your-secure-redis-password-here@redis:6379

# Redis database number (default: 0)
REDIS_DB=0

# Redis key TTL (Time To Live) in seconds
REDIS_TTL=3600

# =============================================================================
# Backend NestJS Configuration
# =============================================================================
# Backend application port (default: 5002)
BACKEND_PORT=5002
PORT=5002
APP_PORT=5002

# Backend API configuration
API_HOST=0.0.0.0
API_PORT=5002
API_PREFIX=/api

# =============================================================================
# JWT Authentication & Security
# =============================================================================
# JWT secret key for signing tokens
# CRITICAL: Change to a strong random string in production
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT access token expiration time (in seconds)
# Default: 86400 (24 hours)
JWT_EXPIRATION=86400

# Session secret for session-based authentication
# CRITICAL: Change to a strong random string in production
SESSION_SECRET=your-secure-random-session-secret-here

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for Cross-Origin requests (comma-separated)
# Examples:
#   Development: http://localhost:5173,http://localhost:3000
#   Production: https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5002

# =============================================================================
# Frontend Next.js Configuration
# =============================================================================
# Frontend application port (default: 5173 for dev, 3000 for prod)
FRONTEND_PORT=5173

# Public API URL (visible to client-side code)
# For Docker: http://backend:5002
# For development: http://localhost:5002
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://backend:5002

# WebSocket URL for real-time features
NEXT_PUBLIC_WS_URL=ws://backend:5002

# Next.js build configuration
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# Optional: External Services Configuration
# =============================================================================

# OpenAI Configuration (optional - required for AI features)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Email Service Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@yourdomain.com

# AWS S3 Configuration (optional - for file storage)
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1

# Stripe Configuration (optional - for payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# =============================================================================
# Docker-specific Configuration
# =============================================================================
# These values are primarily for Docker Compose orchestration
# Volumes and networks are automatically created by docker-compose.yml

# Volume names (auto-managed by Docker Compose)
# POSTGRES_VOLUME=game-plug-postgres-data
# REDIS_VOLUME=game-plug-redis-data

# Network name (auto-managed by Docker Compose)
# DOCKER_NETWORK=game-plug-network

# =============================================================================
# Development & Debugging (NOT for production)
# =============================================================================
# Uncomment to enable debug logging
# DEBUG=game-plug:*,nestjs:*

# Allow insecure HTTP in development
# ALLOW_INSECURE_HTTP=true

# Enable GraphQL Playground (development only)
# GRAPHQL_PLAYGROUND=true

# =============================================================================
# Notes
# =============================================================================
# 1. For production deployments, use strong cryptographic values for all secrets
# 2. Use a password manager or secrets vault to manage sensitive values
# 3. Never commit .env file to version control - only commit .env.example
# 4. Update CORS_ORIGIN for production domains
# 5. Change default database passwords in production
# 6. Generate JWT_SECRET with: openssl rand -hex 32
# 7. For Docker Compose, the database URL should use service name as host (e.g., 'postgres')
# 8. For local development, use 'localhost' as host in URLs
